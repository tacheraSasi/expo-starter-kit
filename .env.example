# API Configuration (used when you swap the mock Api for a real backend;
# the starter kit runs fully offline without these)
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_API_VERSION=v1

# Mobile API auth (optional HMAC signing in lib/api/mobileAuth.ts)
# EXPO_PUBLIC_MOBILE_API_KEY=your-mobile-api-key
# EXPO_PUBLIC_MOBILE_API_SECRET=your-mobile-api-secret

# Build metadata (injected by the Makefile from git)
# EXPO_PUBLIC_COMMIT_HASH=

# Environment (development, staging, production)
EXPO_PUBLIC_ENVIRONMENT=production

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=true

# Debug (set to false for production builds)
EXPO_PUBLIC_DEBUG=false

# Auth Configuration
EXPO_PUBLIC_AUTH_DOMAIN=your-auth-domain

# Storage Configuration
EXPO_PUBLIC_STORAGE_BUCKET=your-storage-bucket-name

# Social Media Configuration (optional)
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
# EXPO_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# Analytics (optional)
# EXPO_PUBLIC_GOOGLE_ANALYTICS_ID=your-ga-id
# EXPO_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token
